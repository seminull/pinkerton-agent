{
  // Typechecks the Node server only: `pnpm typecheck:api`. The web app has its
  // own tsconfig under apps/web.
  "compilerOptions": {
    "lib": ["ESNext"],
    "target": "ESNext",
    // "Preserve" + "bundler" resolution is what lets hono's subpath exports
    // (hono/cors, ...) resolve without writing .js extensions on every import.
    // tsx runs the TypeScript directly, so nothing here is ever emitted.
    "module": "Preserve",
    "moduleDetection": "force",
    "moduleResolution": "bundler",
    "allowImportingTsExtensions": true,
    "verbatimModuleSyntax": true,
    "noEmit": true,
    // The sequelize-cli model/migration files are plain CommonJS .js — allowJs
    // keeps them visible to the typechecker instead of silently unresolved.
    "allowJs": true,
    "resolveJsonModule": true,
    "types": ["node"],

    "strict": true,
    "skipLibCheck": true,
    "noFallthroughCasesInSwitch": true,
    "noUncheckedIndexedAccess": true
  },
  "include": ["server"]
}
