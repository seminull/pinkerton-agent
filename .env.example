# Copy to .env. Compose reads this file automatically; the API reads it via
# --env-file (see the dev:api script) or the container environment.

# --- Postgres -----------------------------------------------------------
# These three are consumed by the postgres container AND interpolated into
# DATABASE_URL below. POSTGRES_PASSWORD lands in a URL unescaped, so keep it
# URL-safe — no @ : / ? # % [ ] characters.
POSTGRES_DB=pinkerton
POSTGRES_USER=pinkerton
POSTGRES_PASSWORD=pinkerton

# Host-side connection string. Port 5434 is the *published* port from
# docker-compose.yml (5432 inside the container) — chosen so this stack can run
# alongside other local Postgres instances without a port fight.
DATABASE_URL=postgres://pinkerton:pinkerton@localhost:5434/pinkerton

# --- API ----------------------------------------------------------------
NODE_ENV=development
PORT=3040

# --- Companion sync -----------------------------------------------------
# Revocable device credential used only by the companion app sync endpoint.
# Generate a long random value before enabling SMS sync.
MOBILE_SYNC_TOKEN=replace-with-a-long-random-token

# --- MLS feed (Bridge Data Output) --------------------------------------
# Bridge is Zillow Group's RESO Web API distribution hub. It delivers the data;
# the MLS still licenses it and approves each feed separately.
#
# Left unset, the API talks to Bridge's public `test` dataset with their
# documented demo token — synthetic records with the real RESO field surface,
# so the Test tab works on a fresh clone with no signup. Nothing here is
# secret until you replace it.
#
# Once NTREIS approves a feed, set both: the dataset code they issue and your
# own server token from the Bridge dashboard. BRIDGE_TOKEN is a real credential
# at that point — keep it out of git.
# BRIDGE_TOKEN=
# BRIDGE_DATASET=test
# BRIDGE_BASE=https://api.bridgedataoutput.com/api/v2/OData
