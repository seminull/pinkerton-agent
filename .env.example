# Copy to .env. Compose reads this file automatically; the API reads it via
# --env-file (see the dev:api script) or the container environment.

# --- Postgres -----------------------------------------------------------
# These three are consumed by the postgres container AND interpolated into
# DATABASE_URL below. POSTGRES_PASSWORD lands in a URL unescaped, so keep it
# URL-safe — no @ : / ? # % [ ] characters.
POSTGRES_DB=pinkerton
POSTGRES_USER=pinkerton
POSTGRES_PASSWORD=pinkerton

# Host-side connection string. Port 5434 is the *published* port from
# docker-compose.yml (5432 inside the container) — chosen so this stack can run
# alongside other local Postgres instances without a port fight.
DATABASE_URL=postgres://pinkerton:pinkerton@localhost:5434/pinkerton

# --- API ----------------------------------------------------------------
NODE_ENV=development
PORT=3040

# --- Sign-in ------------------------------------------------------------
# There is no sign-up page. An account exists because `pnpm user:create` made
# it, or because an address listed here signed in with Google for the first
# time. Comma-separated. Leave empty and Google sign-in can only be used by
# accounts that already exist.
AUTH_ALLOWED_EMAILS=

# Addresses that should hold the admin role (manage users). Comma-separated.
# Takes effect when that person signs in, and only once their email is verified
# by a Google sign-in — a password account is never promoted by this list. For
# a password-only account use `pnpm user:admin <email>` instead.
ADMIN_EMAILS=

# Google sign-in. All three or none — the button only appears when all are
# set. Create an OAuth 2.0 "Web application" client in Google Cloud and add the
# redirect URI below to it exactly, character for character. These are server
# secrets: never give them a VITE_ prefix, which would ship them to browsers.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# Dev goes through the Vite proxy, hence 5174 rather than the API's 3040.
# Production: https://<your domain>/api/auth/google/callback
GOOGLE_REDIRECT_URI=http://localhost:5174/api/auth/google/callback

# Session cookies are marked Secure when NODE_ENV=production and not otherwise.
# Only set this to override that — e.g. `false` for a production build reached
# over plain http on a LAN, where the browser would otherwise drop the cookie.
# AUTH_COOKIE_SECURE=

# --- Production only (docker-compose.prod.yml) --------------------------
# Loopback port the web container is published on. Only worth setting if 8090
# is already taken on the host.
# WEB_PORT=8090
